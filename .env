# Database Configuration
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=bhojon_db
MYSQL_USER=bhojon_user
MYSQL_PASSWORD=bhojon_password

# Application Configuration
APP_ENV=production
APP_DEBUG=false

# Database Host (use service name in Docker)
DB_HOST=mysql
DB_PORT=3306
